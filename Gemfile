source "https://rubygems.org"

# GitHub Pages builds and deploys this site itself, server-side, using its
# own pinned Jekyll + plugin versions — this Gemfile is only for local
# preview (`make serve`), not for deployment. Plain jekyll (rather than the
# heavier `github-pages` gem) is used here for broader local Ruby-version
# compatibility; GitHub's build is unaffected either way.
gem "jekyll"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
